# 使用已启用 pgvector 扩展的 PostgreSQL 16+ 数据库。
# 请在本地 .env 中填写真实密码，严禁提交到仓库。
DATABASE_URL=postgresql://postgres:YOUR_DATABASE_PASSWORD@localhost:5432/xuanshu

# DeepSeek 用于 Agent 问答和工具调用。
DEEPSEEK_API_KEY=YOUR_DEEPSEEK_API_KEY
XUANSHU_CHAT_MODEL=deepseek/deepseek-v4-flash

# 豆包 Embedding 配置。多模态接口会按文本逐条请求并校验向量维度。
EMBEDDING_API_KEY=YOUR_EMBEDDING_API_KEY
EMBEDDING_BASE_URL=https://ark.cn-beijing.volces.com/api/v3/embeddings/multimodal
EMBEDDING_MODEL=doubao-embedding-vision-251215
# 向量维度必须与 Mastra PgVector 索引一致。
EMBEDDING_DIM=2048
