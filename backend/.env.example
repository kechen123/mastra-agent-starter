# 使用已启用 pgvector 扩展的 PostgreSQL 16+ 数据库。
# 请在本地 .env 中填写真实密码，严禁提交到仓库。
# 与根目录 docker-compose.yml 的本地开发数据库一致；生产环境请替换为独立凭据。
DATABASE_URL=postgresql://mastra_agent_starter:mastra_agent_starter@localhost:5432/mastra_agent_starter

# 集成测试专用连接串：必须指向一个**形如 test_* / *_test 的独立测试库**，
# 与 DATABASE_URL 物理隔离。`assertTestDatabase()` 会在连接后执行
# `SELECT current_database()` 并校验返回值落在测试库命名允许列表
# （test_<...> / <...>_test / 独立 `test`），拒绝任何"看上去像测试库"
# 但其实指向预发 / 共享 / 生产库的连接串。
# 本地开发可使用：
#   createdb -h localhost -U postgres test_xuanshu
# 然后：
#   TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/test_xuanshu
# TEST_DATABASE_URL=

# 当前仅允许 demo。production 会拒绝启动，直到认证、租户隔离与限流阶段完成。
DEPLOYMENT_PROFILE=demo

# 品牌配置（可选；不填时使用后端默认）。
# APP_NAME 决定前端 UI 与 /capabilities 返回的产品名，默认 Mastra Agent Starter。
# APP_SHORT_NAME 是更短的展示名（侧边栏 logo、空状态文案），默认 Mastra。
APP_NAME=Mastra Agent Starter
APP_SHORT_NAME=Mastra

# ────────────────────────────────────────────────────────────────────────
# LLM Provider 配置（当前仅启用 DeepSeek）
# ────────────────────────────────────────────────────────────────────────
# LLM_PROVIDER 决定由哪个 Provider Adapter 提供聊天模型。
# 当前 Registry 仅注册 `deepseek`；未注册值在首次解析模型时被明确拒绝（中文错误）。
LLM_PROVIDER=deepseek

# LLM_MODEL 是"不含 provider 前缀"的模型短名；完整模型 ID（`deepseek/<model>`）
# 由 Provider Adapter 内部拼接。
LLM_MODEL=deepseek-v4-flash

# 当前 Provider 的凭据。DeepSeek 凭据缺失时，Agent 工厂首次被调用时
# 会抛错（明确中文，错误信息不包含 key 本身）。
DEEPSEEK_API_KEY=YOUR_DEEPSEEK_API_KEY

# 历史兼容：旧的 AGENT_CHAT_MODEL 已被 LLM_PROVIDER + LLM_MODEL 取代。
# 如果仍在 .env 中保留为 `deepseek/<model>` 形式，配置层会解析出模型短名并
# 输出一条弃用警告；若设置成其他 Provider 前缀则会被明确拒绝。
# AGENT_CHAT_MODEL=deepseek/deepseek-v4-flash

# 历史兼容：XUANSHU_CHAT_MODEL 比 AGENT_CHAT_MODEL 更旧。设置后仅输出一条
# 警告告知该变量已废弃，**不**参与实际模型解析。
# XUANSHU_CHAT_MODEL=deepseek/deepseek-v4-flash

# ────────────────────────────────────────────────────────────────────────
# Embedding（PR-4：默认 Core-only，RAG 启用由 EMBEDDING_API_KEY 存在决定）
# ────────────────────────────────────────────────────────────────────────
# EMBEDDING_API_KEY 留空 = Core-only 部署：
#   - `config.ragEnabled = false`；
#   - bootstrap 不执行 `CREATE EXTENSION vector`，不创建
#     `embedding_profiles` / `document_embeddings`；
#   - Core 路径完全脱离 pgvector，可启动在任何 PostgreSQL 15+ 实例上；
#   - 文档 chunk 文本仍落 `document_chunks`，可被引用与全文检索。
# EMBEDDING_API_KEY 填非空字符串 = 启用 RAG：
#   - `config.ragEnabled = true`；
#   - bootstrap 在 init 事务内创建 `vector` 扩展 + RAG 表 + 普通过滤索引；
#   - **运行时必须使用真实可用的 key**——任意非空字符串能让
#     `ragEnabled` 翻为 true，但随后真实 embedding 调用会被 Provider
#     拒绝（401/403）；本示例文件继续保持为空，禁止写真实 key；
#     复制示例到本地 `.env` 后再填写真实凭据。
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://ark.cn-beijing.volces.com/api/v3/embeddings/multimodal
EMBEDDING_MODEL=doubao-embedding-vision-251215
# 向量列与维度边界：
# - 实际写入路径是 `document_embeddings.embedding`（**可变**维度列），
#   DB DDL **不**固定为 `vector(2048)`。
# - 维度由当前 workspace 的 active embedding profile 决定，profile 是
#   未来模型/维度切换的数据库生命周期承担方。
# 当前 Starter 运行时限制（与 `backend/src/config.ts` 一致）：
#   - `EMBEDDING_DIM` 启动时强制校验 `=== 2048`，不一致直接抛错；
#   - 仅修改 `EMBEDDING_DIM` **无法**切换模型维度——DB 列、profile、
#     Provider 三方仍按当前 Starter 默认绑定；
#   - 真正的跨维度 profile 切换（按 `(profile_id, dimensions)` 建 partial
#     HNSW、旧向量迁移、跨模型 re-embed 等）属后续 Provider/Profile
#     生命周期能力，**不是**当前 Starter 已开放的功能。
EMBEDDING_DIM=2048

# RAG 相似度阈值（PR-4.3）。检索时 chunk 必须 similarity >= 此阈值才会进入
# 引用列表；全部低于阈值时 retriever 返回 []，agent 走"未命中可靠数据"
# 语义，**绝不**注入不相关片段。
#
# similarity ∈ [0, 1]，由 pgvector cosine distance = 1 - similarity 换算。
#
# **依赖模型 / 数据集**：切换 Embedding 模型或更换知识库语料后必须重新
# 校准。默认 0.5 仅作为起步值；生产环境应在本地 .env 显式覆盖。
# 范围严格 [0, 1]，区间外启动直接抛错。
RAG_MIN_SIMILARITY=0.5

# Embedding 上游 HTTP 请求超时（PR-4.3）。超时会立即中断 fetch 并归类为
# EmbeddingError('network')，上层 retriever 按"未命中可靠数据"处理，绝不
# 抛原始 fetch 错误文本。
# 默认 15000ms（15s）；依赖上游 SLA 与 batch size，运维按需覆盖。
# 必须是正整数（毫秒）。
EMBEDDING_TIMEOUT_MS=15000

# 文档上传限制由代码固定：单个文件 10 MB，multipart 请求体 10.5 MB（为
# boundary / 字段头预留）。生产反向代理的 client_max_body_size / body limit
# 必须设为相同或更低；本项目目前没有以环境变量放宽该限制的入口。

# 可选：MinerU 文档解析服务（PDF/DOCX）。默认关闭，仅作为 HTTP Client 调用，Node 侧不运行 Python。
# 如需启用，请同时启动 mineru-api 并设置 ENABLE_MINERU=true。
ENABLE_MINERU=false
MINERU_API_BASE_URL=http://127.0.0.1:8000
MINERU_PARSE_TIMEOUT_MS=120000

# ────────────────────────────────────────────────────────────────────────
# 本地账号密码登录（Phase 1）
# ────────────────────────────────────────────────────────────────────────
# 会话有效期（天），正整数，默认 7 天。
AUTH_SESSION_TTL_DAYS=7

# Cookie 的 Secure 标志。本地开发保持 false；生产部署必须显式设为 true。
AUTH_COOKIE_SECURE=false

# 不安全 HTTP 方法 + /auth/login 的合法 Origin。本地默认 Vite dev server。
AUTH_ALLOWED_ORIGIN=http://localhost:5173
