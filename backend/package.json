{
  "name": "mastra-agent-starter",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "mastra dev",
    "start": "mastra start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test:contracts": "tsx tests/contracts/run.ts",
    "test:unit": "tsx tests/unit/run.ts",
    "test:integration": "tsx tests/integration/run.ts",
    "test:fixtures": "tsx tests/fixtures/skill-classifier.ts",
    "test": "npm run test:contracts && npm run test:unit && npm run test:integration && npm run test:fixtures",
    "migrate": "tsx src/scripts/migrate.ts",
    "ask": "tsx src/scripts/ask.ts",
    "users:create": "tsx src/scripts/users-create.ts"
  },
  "dependencies": {
    "@mastra/core": "1.61.0",
    "@mastra/pg": "1.21.1",
    "@mastra/rag": "2.6.0",
    "@mastra/server": "1.61.0",
    "dotenv": "^16.5.0",
    "mastra": "1.26.0",
    "pg": "^8.16.0",
    "pino": "^9.14.0",
    "pino-pretty": "^11.3.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.0",
    "eslint": "^10.9.1",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.68.0"
  }
